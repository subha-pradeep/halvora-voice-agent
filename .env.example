# ---- Copy to .env and fill in. Never commit .env. ----
# Public URL of this deployment (no trailing slash). Twilio webhooks and Vapi tools call this.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Core (free tiers) ---
GEMINI_API_KEY=            # https://aistudio.google.com  (LLM + Gemini Live speech-to-speech)
GROQ_API_KEY=              # https://console.groq.com     (Low Latency mode LLM)
DEEPGRAM_API_KEY=          # https://console.deepgram.com (streaming ASR + TTS)
OPENAI_API_KEY=            # optional, paid

# --- Model overrides (optional) ---
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_LIVE_MODEL=        # empty = auto-detect a Live (bidiGenerateContent) model for your key
# GROQ_MODEL=llama-3.1-8b-instant
# DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# --- Twilio (phone) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=       # E.164, e.g. +15551234567
# TWILIO_PROFILE=fast
# CALLBACK_DAILY_LIMIT=40

# --- LiveKit Cloud ---
LIVEKIT_URL=               # wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# AGENT_SERVER_URL=http://127.0.0.1:3000   # where the LiveKit worker reaches this server

# --- Vapi ---
VAPI_PUBLIC_KEY=
# VAPI_ASSISTANT_ID=        # optional: use an assistant created in the Vapi dashboard instead of the inline one
VAPI_SERVER_SECRET=        # any random string; Vapi sends it back on tool calls
# VAPI_MODEL_PROVIDER=google
# VAPI_MODEL=gemini-2.5-flash

# --- Security ---
INTERNAL_SECRET=           # random string shared by the server and LiveKit worker
ADMIN_TOKEN=               # random string, lets you DELETE /api/metrics
# ALLOW_CLIENT_KEYS=true    # evaluators may paste their own keys on /settings
# MAX_SESSIONS=25
